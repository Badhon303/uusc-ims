@startuml
hide circle
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam defaultFontSize 11
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #475569
}

' =====================================================
' PLATFORM, TENANCY & AUTHENTICATION
' =====================================================

entity Tenants {
  *id: INT <<PK>>
  --
  *name: text
  *slug: text <<UNIQUE>>
  contactNumber: text
  address: text
  *isActive: boolean
  --
  settings: group[trialDurationDaysDefault, billingReminderDaysBefore, readOnlyOnSuspended, cancellationPolicy]
  subscriptionPlan: group[billingType, monthlyPrice, oneTimePrice, currency, setupFee, features]
  *subscriptionStatus: enum[trialing, active, past_due, suspended, cancelled]
  *billingCycle: enum[monthly, one-time]
  trialStartedAt: datetime
  trialEndsAt: datetime
  currentPeriodStart: datetime
  currentPeriodEnd: datetime
  nextBillingDate: datetime
  gracePeriodDays: number
  *autoSuspendOnExpiry: boolean
  lifetimePurchasedAt: datetime
  setupFeeChargedAt: datetime
  suspendedAt: datetime
  suspendedReason: textarea
  cancelledAt: datetime
  cancelledReason: textarea
}

entity Users {
  *id: INT <<PK>>
  --
  *email: email <<UNIQUE>>
  *name: text
  contactNumber: regex
  *role: enum[super-admin, admin, manager, coach, staff, member, student, guest]
  *isSuperAdmin: boolean
  tenantSubscriptionStatus: text
  address: text
  tenants: array[tenantId <<FK>>]
}

entity Media {
  *id: INT <<PK>>
  --
  alt: text
  url: text
  filename: text
  mimeType: text
  filesize: number
}

entity AuditLogs {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  userId: INT <<FK>>
  action: text
  collection: text
  documentId: text
  data: json
}

entity Notifications {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *userId: INT <<FK>>
  channel: enum[email, in-app, whatsapp]
  type: text
  status: enum[pending, sent, failed]
  payload: json
}

' =====================================================
' PLATFORM BILLING (Tenant pays the platform / super admin)
' =====================================================

entity SubscriptionInvoices {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  planSnapshot: group[billingType, monthlyPrice, oneTimePrice, currency, setupFee]
  *invoiceType: enum[subscription, one-time]
  lineItems: array[label, kind, amount]
  billingPeriodStart: datetime
  billingPeriodEnd: datetime
  *dueAt: datetime
  *amount: number
  *currency: text
  *status: enum[draft, pending, paid, failed, void]
  paymentMethod: enum[bkash, nagad, sslcommerz, manual/bank-transfer]
  gatewayTransactionId: text
  *issuedAt: datetime
  paidAt: datetime
  createdBy: INT <<FK>>
}

entity SubscriptionEvents {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *eventType: enum[trial_started, trial_extended, trial_converted, plan_changed, one_time_purchased, setup_fee_charged, invoice_generated, payment_received, payment_failed, suspended, reactivated, cancelled]
  fromValue: json
  toValue: json
  triggeredBy: INT <<FK>>
  note: textarea
}

' =====================================================
' USER PROFILES & MEMBERSHIP
' =====================================================

entity Members {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *userId: INT <<FK>>
  profilePictureId: INT <<FK>>
  *status: enum[active, pending, inactive]
  joinDate: date
  totalDue: number
  totalPaid: number
  achievements: array[photoId, description]
}

entity Students {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *userId: INT <<FK>>
  profilePictureId: INT <<FK>>
  parentName: text
  parentContactNumber: regex
  joinDate: date
  skillLevel: enum
  ranking: number
  *membershipStatus: enum[active, pending, inactive]
  achievements: array[photoId, description]
}

entity Managers {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *userId: INT <<FK>>
  profilePictureId: INT <<FK>>
  *joinDate: date
  status: enum[active, pending, inactive]
}

entity Staffs {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  profilePictureId: INT <<FK>>
  name: text
  contactNumber: regex
  address: text
  *joinDate: date
  status: enum[active, pending, inactive]
}

entity Coaches {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *userId: INT <<FK>>
  profilePictureId: INT <<FK>>
  specialization: richText
  certification: array[photoId, description]
  joinDate: date
  status: enum[active, pending, inactive]
}

' =====================================================
' PACKAGES, MEMBERSHIP & ATTENDANCE
' =====================================================

entity Packages {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *title: text
  *price: number
  *registrationFee: number
  features: array[feature]
}

' =====================================================
' TENANT INCOME (members, students, and users pay the tenant)
' =====================================================

entity MemberPayments {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *memberId: INT <<FK>>
  *registrationFee: number
  *paymentMonth: date
  *amount: number
  paymentMethod: enum[cash, mobile-banking, card]
  transactionRef: text
  *status: enum[Paid, Unpaid]
}

entity StudentPayments {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *studentId: INT <<FK>>
  *registrationFee: number
  *paymentMonth: date
  *amount: number
  paymentMethod: enum[cash, mobile-banking, card]
  transactionRef: text
  *status: enum[Due, Paid]
}

entity Payments {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  payer: polymorphic FK[members, students, users]
  amount: number
  paymentMethod: enum[cash, bkash, nagad, sslcommerz, card]
  status: enum[pending, paid, failed, refunded, due]
  transactionRef: text
  invoiceNumber: text
  context: enum[membership, registration-fee, court-booking, tournament-fee]
  contextRefId: text
  dueDate: date
  paidAt: date
}

entity BookingPayments {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *bookingId: INT <<FK>>
  *totalAmount: number
  *paymentStatus: enum[Paid, Unpaid]
}

entity OtherIncomes {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *type: enum[membership, registration, tournament, other]
  *amount: decimal
  incomeDate: date
  description: textarea
}

entity StudentAttendance {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *studentId: INT <<FK>>
  attendances: array[month, notes, absentDays[type, date]]
}

' =====================================================
' ACADEMY TRAINING
' =====================================================

entity TrainingGroups {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *studentId: INT <<FK>>
  *coachId: INT <<FK>>
  *skillLevel: enum[beginner, intermediate, pro]
}

entity TrainingSchedules {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *trainingGroupId: INT <<FK>>
  *coachId: INT <<FK>>
  *courtId: INT <<FK>>
  *dayOfWeek: enum
  *startTime: datetime
  *endTime: datetime
}

entity MemberSchedules {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *courtId: INT <<FK>>
  *dayOfWeek: enum
  *startTime: datetime
  *endTime: datetime
}

entity StudentProgress {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *studentId: INT <<FK>>
  *coachId: INT <<FK>>
  evaluation: array[skillCategory, score, remarks]
}

' =====================================================
' COURTS & BOOKINGS
' =====================================================

entity Courts {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *name: text
  *peakHourPrice: number
  *normalHourPrice: number
}

entity CourtBookings {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *userId: INT <<FK>>
  *courtId: INT <<FK>>
  *bookingDate: date
  *startTime: datetime
  *endTime: datetime
  status: enum
}

entity BookingPayments {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *bookingId: INT <<FK>>
  *totalAmount: number
  *paymentStatus: enum[Paid, Unpaid]
}

' =====================================================
' TOURNAMENTS
' =====================================================

entity Tournaments {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *name: text
  *registrationFee: number
  *tournamentType: enum[Academy, Members, Academy&Members, OpenForAll]
  registrationStartDate: date
  registrationEndDate: date
  status: enum[open, closed]
}

entity TournamentRegistrations {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *tournamentId: INT <<FK>>
  *userId: INT <<FK>>
  registrationDate: datetime
  paymentDate: date
  status: enum[Due, paid]
}

entity TournamentTeams {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *teamName: text
  *tournamentId: INT <<FK>>
  *playerOne: INT <<FK>>
  playerTwo: INT <<FK>>
}

entity TournamentMatches {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *tournamentId: INT <<FK>>
  *teamOneId: INT <<FK>>
  *teamTwoId: INT <<FK>>
  *courtId: INT <<FK>>
  winnerId: INT <<FK>>
  scheduledTime: datetime
  teamOneScore: number
  teamTwoScore: number
}

entity TournamentResults {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *tournamentId: INT <<FK>>
  *teamId: INT <<FK>>
  *position: number
  prizeAmount: decimal
}

' =====================================================
' TENANT EXPENSES & SPONSORS (tenant pays staff, vendors, etc.)
' =====================================================

entity Expenditures {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *type: enum[salaries, maintenance, utility, equipment, tournament, facility, miscellaneous]
  *amount: decimal
  expenditureDate: date
  description: textarea
}

entity CoachSalaries {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *coachId: INT <<FK>>
  totalDue: number
  totalPaid: number
  salaries: array[paymentMonth, salary, bonus, status]
}

entity Sponsors {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  *coachId: INT <<FK>>
  totalDue: number
  totalPaid: number
  salaries: array[paymentMonth, salary, bonus, status]
}

entity Sponsors {
  *id: INT <<PK>>
  --
  *tenantId: INT <<FK>>
  photoId: INT <<FK>>
  *sponsorName: text
  *contactNumber: regex
  amounts: array[amount, date]
}

' =====================================================
' RELATIONSHIPS
' =====================================================

' Tenant ownership: injected by @payloadcms/plugin-multi-tenant
Tenants ||--o{ Users : memberships
Tenants ||--o{ Members
Tenants ||--o{ Students
Tenants ||--o{ Managers
Tenants ||--o{ Staffs
Tenants ||--o{ Coaches
Tenants ||--o{ Packages
Tenants ||--o{ Payments
Tenants ||--o{ MemberPayments
Tenants ||--o{ StudentPayments
Tenants ||--o{ StudentAttendance
Tenants ||--o{ TrainingGroups
Tenants ||--o{ TrainingSchedules
Tenants ||--o{ MemberSchedules
Tenants ||--o{ StudentProgress
Tenants ||--o{ Courts
Tenants ||--o{ CourtBookings
Tenants ||--o{ BookingPayments
Tenants ||--o{ Tournaments
Tenants ||--o{ TournamentRegistrations
Tenants ||--o{ TournamentTeams
Tenants ||--o{ TournamentMatches
Tenants ||--o{ TournamentResults
Tenants ||--o{ Expenditures
Tenants ||--o{ OtherIncomes
Tenants ||--o{ CoachSalaries
Tenants ||--o{ Sponsors
Tenants ||--o{ Notifications
Tenants ||--o{ AuditLogs
Tenants ||--o{ SubscriptionInvoices
Tenants ||--o{ SubscriptionEvents

' User profiles
Users ||--o| Members
Users ||--o| Students
Users ||--o| Managers
Users ||--o| Coaches
Users ||--o{ TournamentRegistrations
Users ||--o{ TournamentTeams
Users ||--o{ CourtBookings
Users ||--o{ Notifications
Users ||--o{ AuditLogs
Users ||--o{ SubscriptionEvents : triggeredBy

' Media
Media ||--o{ Members
Media ||--o{ Students
Media ||--o{ Managers
Media ||--o{ Coaches
Media ||--o{ Staffs
Media ||--o{ Sponsors

' Membership, attendance, and tenant income
Members ||--o{ MemberPayments
Students ||--o{ StudentPayments
Students ||--o{ StudentAttendance

' Tenant income (members/students/users pay the tenant)
Members ||--o{ Payments
Students ||--o{ Payments
Users ||--o{ Payments
CourtBookings ||--o{ BookingPayments
TournamentRegistrations ||--o{ Payments : tournament-fee
Payments ||--o{ OtherIncomes : auto-created on paid

' Tenant expenses (tenant pays staff/vendors)
Coaches ||--o| CoachSalaries

' Platform billing (tenant pays the platform/super admin)
Tenants ||--o{ SubscriptionInvoices
SubscriptionInvoices ||--o{ SubscriptionEvents : generates

' Training
Students ||--o{ TrainingGroups
Coaches ||--o{ TrainingGroups
TrainingGroups ||--o{ TrainingSchedules
Coaches ||--o{ TrainingSchedules
Courts ||--o{ TrainingSchedules
Courts ||--o{ MemberSchedules
Students ||--o{ StudentProgress
Coaches ||--o{ StudentProgress

' Courts and bookings
Courts ||--o{ CourtBookings
CourtBookings ||--o{ BookingPayments

' Tournaments
Tournaments ||--o{ TournamentRegistrations
Tournaments ||--o{ TournamentTeams
Tournaments ||--o{ TournamentMatches
Tournaments ||--o{ TournamentResults
TournamentTeams ||--o{ TournamentMatches
TournamentTeams ||--o{ TournamentResults
Courts ||--o{ TournamentMatches

' Finance
Coaches ||--o| CoachSalaries

@enduml
